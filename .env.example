# Copy to .env (gitignored) and fill in. Used only with --llm openai --allow-paid.
# Any OpenAI-compatible /chat/completions endpoint works (OpenAI, vLLM, Ollama, OpenRouter...).
NOESIS_LLM_BASE_URL=https://api.openai.com/v1
NOESIS_LLM_API_KEY=replace-me
NOESIS_LLM_MODEL=gpt-5.4-mini
# Hard cap on LLM calls per process (spending guard).
NOESIS_LLM_MAX_CALLS=200
